package sqlite:wasm@0.1.0;

/// SQLite-in-WASM with the unified sqlite:extension contract.
///
/// Targeted by the C CLI binary `build/sqlite-cli-unified.wasm`
/// (built from `src/cli/sqlite_cli.c` via the Makefile's
/// `bindings-unified` target). The host (sqlink itself,
/// internally) calls each composed extension's per-slot
/// `describe()` at startup, registers the manifest entries with
/// SQLite, and dispatches by calling the slot's `call()` when SQL
/// invokes a function — declarative dispatch in contrast to the
/// imperative `register-scalar-function` flow of older C builds.
///
/// Exports:
///   - low-level / high-level — SQLite's own API
///   - sqlite:extension/types — sql-value variant + associated enums
///   - sqlite:extension/spi — execute / execute-scalar / execute-batch
///     so composed extensions can run SQL
///   - sqlite:extension/logging — structured logging from extensions
///   - sqlite:extension/config — version / config lookups
///
/// Imports:
///   - Per-extension slot interfaces (fts5-slot, json1-slot,
///     rtree-slot, geopoly-slot). Each slot is structurally identical
///     to `metadata.describe + scalar-function.call` but has a
///     distinct identity so `wasm-tools compose -d <name>=...` and
///     `wac compose` can wire each composed extension to its own
///     dispatch port. Unwired slots mean the extension isn't included
///     in this binary; the host tolerates this.
///   - extension-loader — host-implemented dynamic load (.load)
///   - zip-operations — host-implemented .archive support
///
world sqlite-cli-unified {
    export low-level;
    export high-level;

    export sqlite:extension/types@1.0.0;
    export sqlite:extension/spi@1.0.0;
    export sqlite:extension/logging@1.0.0;
    export sqlite:extension/config@1.0.0;

    import fts5-slot;
    import json1-slot;
    import rtree-slot;
    import geopoly-slot;
    import demo-slot;

    import extension-loader;
    import dispatch;
    import zip-operations;
}

/// Command-mode CLI. The component owns its own REPL via
/// `wasi:cli/run`: any wasi:p2 host (wasmtime, jco, our polyfill
/// in the browser) can run it with no special host plumbing
/// beyond the extension-loader / dispatch imports we provide for
/// the dynamic-load story.
///
/// Successor to `sqlite-cli-reactor`, which had a six-method
/// interactive interface the host drove turn-by-turn. The reactor
/// was originally chosen to enable live-SPI bridge re-entry; that
/// route was architecturally impossible (see
/// `host/SPI-LIVE-ARCHITECTURE.md`) and the pattern's costs
/// (split state, async lifts, six methods coordinating across the
/// host/guest boundary) bought us nothing. Command-mode is the
/// honest shape.
///
/// Programmatic / library use ("eval this SQL, give me rows")
/// belongs in a separate `sqlite-library` world targeted by a
/// distinct crate. This world is just a CLI.
world sqlite-cli-command {
    include wasi:cli/command@0.2.6;

    import extension-loader;
    import dispatch;
    /// Stage 1 of PLAN-cli-shared-conn.md: the cli world now
    /// imports the same SQL surface extensions use. Today
    /// (Stage 1) the cli still owns its own CLI_CONN via
    /// libsqlite3-sys and uses these imports for nothing
    /// the host wires them in so subsequent stages can migrate
    /// eval_sql + dot.rs callers off the local connection one
    /// path at a time.
    import sqlite:extension/spi@1.0.0;
    import sqlite:extension/spi-loader@1.0.0;
    import sqlite:extension/prepared@1.0.0;
    import sqlite:extension/session@1.0.0;
}

/// Programmatic SQLite library world.
///
/// Targeted by the sqlite-lib crate. Use this when you want SQLite
/// functionality as a callable WIT surface from another component
/// (a runnable component, a web frontend, an SPI consumer) rather than
/// as a CLI you drive over stdin. Exports both:
///
///   - the complete SPI surface (so a composed extension can use
///     this component as its SQL backend at compose time), and
///   - a sugar interface (`high-level`'s Connection / Statement
///     resources) for callers that prefer ergonomic Rust-style
///     calls over raw `execute(sql, params)`.
///
/// A small `library` interface ties in REPL utilities, version
/// queries, and a programmatic `load-extension` path.
///
/// Imports the standard `extension-loader` and `dispatch`. Callers
/// that don't need dynamic loading can satisfy `extension-loader`
/// with a stub.
world sqlite-library {
    export sqlite:extension/types@1.0.0;
    export sqlite:extension/spi@1.0.0;
    export sqlite:extension/logging@1.0.0;
    export sqlite:extension/config@1.0.0;
    /// Raw WAL-frame access. Browser-side this returns the
    /// documented no-WAL sentinels until vfs-tvm grows WAL
    /// support (#437); the contract stays honored so widened
    /// worlds that import wal-frames can compose against
    /// sqlite-lib without panicking.
    export sqlite:extension/wal-frames@1.0.0;
    /// S3-compatible object storage. Browser-side this returns
    /// a structured "not implemented" error until the polyfill
    /// bridge (fetch + SigV4 in JS) lands as a follow-up to
    /// #437  the wal-archive extension's primary off-box sink
    /// requires native deployment for v1.
    export sqlite:extension/s3-base@1.0.0;
    /// Host-resident cargo build. Browser-side this is stubbed
    /// (wasm sandboxes can't spawn cargo); the contract is
    /// exported so worlds that import build link cleanly
    /// against sqlite-lib. The bundle-cli extension's baked-
    /// binary path requires native deployment by design.
    export sqlite:extension/build@1.0.0;
    /// Bundle registry CRUD. Browser-side this is stubbed
    /// (no host cas-cache reachable from the wasm sandbox);
    /// the contract is exported so worlds that import bundles
    /// link cleanly against sqlite-lib. A future browser
    /// deployment can implement IndexedDB-backed bundles.
    export sqlite:extension/bundles@1.0.0;

    export low-level;
    export high-level;
    export library;
    /// Host-resident scalar registration bridge. The JS host calls
    /// `dispatch-bridge.register-host-scalar` from its
    /// `spi-loader.register-scalar` impl, sqlite-lib installs a
    /// `sqlite3_create_function_v2` trampoline whose body re-enters
    /// the host via the imported `dispatch.scalar-call`. See
    /// `wit/dispatch-bridge.wit` for the full lifecycle.
    export dispatch-bridge;
    /// CAS-cache `bridged-execute-cas` slice, split out of
    /// `dispatch-bridge` so consumers that only need cas-conn SQL
    /// access (the bundle-cli extension; the native sqlink-host)
    /// don't carry the 11 register-host-* trampolines. The browser
    /// composed binary continues to export both: sqlite-lib's
    /// composed runtime serves cas reads/writes through this
    /// interface the same way it previously did through
    /// `dispatch-bridge.bridged-execute-cas`.
    export dispatch-bridge-cas;

    import extension-loader;
    import dispatch;
    /// Host-implemented OPFS file ops backing the `opfs` VFS the
    /// browser composed runtime uses for `shared_cas_conn` so the
    /// cas db survives page reloads. See wit/opfs-host.wit for the
    /// per-op contract. Native sqlite-lib targets satisfy this with
    /// a stub (cas db opens against the native filesystem and never
    /// calls into opfs-host); the browser composed cli wires this
    /// to navigator.storage.getDirectory().
    import opfs-host;
}
